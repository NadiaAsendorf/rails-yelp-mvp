<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h1 class="h3 mb-1">New review</h1>
        <p class="text-muted mb-4">for <%= @restaurant.name %></p>
        <%= simple_form_for [@restaurant, @review] do |f| %>
          <%= f.input :rating, collection: (0..5).to_a, prompt: "Choose a rating" %>
          <%= f.input :content, as: :text, label: "Your review", input_html: { rows: 4 } %>
          <div class="d-flex gap-2 mt-3">
            <%= f.submit "Submit review", class: "btn btn-danger" %>
            <%= link_to "Cancel", restaurant_path(@restaurant), class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
