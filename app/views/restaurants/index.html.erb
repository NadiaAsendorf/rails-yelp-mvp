<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 mb-0">All restaurants</h1>
  <%= link_to "+ Add a restaurant", new_restaurant_path, class: "btn btn-danger" %>
</div>

<div class="row g-4">
  <% @restaurants.each do |restaurant| %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body">
          <span class="badge text-bg-secondary mb-2"><%= restaurant.category.capitalize %></span>
          <h2 class="h5 card-title">
            <%= link_to restaurant.name, restaurant_path(restaurant), class: "stretched-link text-decoration-none text-dark" %>
          </h2>
          <p class="card-text text-muted mb-0">📍 <%= restaurant.address %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
