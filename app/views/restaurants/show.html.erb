<%= link_to "← All restaurants", restaurants_path, class: "btn btn-link px-0 mb-3" %>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <span class="badge text-bg-secondary mb-2"><%= @restaurant.category.capitalize %></span>
    <h1 class="h2"><%= @restaurant.name %></h1>
    <p class="text-muted mb-1">📍 <%= @restaurant.address %></p>
    <% if @restaurant.phone_number.present? %>
      <p class="text-muted mb-0">📞 <%= @restaurant.phone_number %></p>
    <% end %>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="h4 mb-0">Reviews (<%= @restaurant.reviews.size %>)</h2>
  <%= link_to "+ Add a review", new_restaurant_review_path(@restaurant), class: "btn btn-danger" %>
</div>

<% if @restaurant.reviews.any? %>
  <div class="list-group shadow-sm">
    <% @restaurant.reviews.each do |review| %>
      <div class="list-group-item py-3">
        <div class="text-warning mb-1" title="<%= review.rating %> out of 5">
          <%= "★" * review.rating %><span class="text-body-tertiary"><%= "★" * (5 - review.rating) %></span>
        </div>
        <p class="mb-0"><%= review.content %></p>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No reviews yet. Be the first!</p>
<% end %>
